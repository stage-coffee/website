  },
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@contentful/app-sdk": "^4.69.0",
    "@contentful/rich-text-react-renderer": "^15.19.6",
    "@contentful/rich-text-types": "^16.8.5",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "astro": "^7.2.10",
    "contentful-management": "^12.16.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "prettier": "^3.9.6",
