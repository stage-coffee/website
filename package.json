    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "contentful:setup-admin": "node scripts/setup-admin-app.mjs",
    "contentful:setup-home-menu": "node scripts/setup-home-menu-section.mjs",
