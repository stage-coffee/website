---
import ContactForm from './ContactForm'
import type { Document } from '@contentful/rich-text-types'

interface Props {
  contact?: Document | null
}
const { contact } = Astro.props
---

<footer class="site-footer">
  {contact !== undefined && <ContactForm introduction={contact} client:load />}
  <section class="visit-section section-shell">
    <div class="visit-copy">
      <h2>Find us</h2>
      <p>41 Great George Street<br />Leeds, Yorkshire<br />LS1 3BB</p>
      <a
        class="text-link"
        href="https://www.instagram.com/stagecoffeeleeds/"
        target="_blank"
        rel="noreferrer">Follow @stagecoffeeleeds</a
      >
    </div>
    <iframe
      class="map-frame"
      title="Map showing Stage Espresso & Brewbar"
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2356.3609374552366!2d-1.5534804865731675!3d53.80086087230954!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x48795c1d7a9eaaab%3A0xcb6995a363333532!2sStage%20Espresso%20%26%20Brewbar!5e0!3m2!1sen!2suk!4v1713285436412!5m2!1sen!2suk"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"></iframe>
  </section>
  <div class="footer-bar">
    <div class="section-shell footer-bar-inner">
      <p>© {new Date().getFullYear()} Stage Espresso & Brewbar</p>
      <p>Independent coffee in Leeds since 2017.</p>
    </div>
  </div>
</footer>
