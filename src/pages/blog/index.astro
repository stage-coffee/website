---
import BlogIndexView from '../../components/BlogIndexView'
import BaseLayout from '../../layouts/BaseLayout.astro'
import {
  getProductionBlogPosts,
  getProductionContent,
} from '../../lib/contentful'

const [posts, content] = await Promise.all([
  getProductionBlogPosts(),
  getProductionContent(),
])
const description =
  'News, stories and updates from Stage Espresso & Brewbar in Leeds.'
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'From Stage',
  description,
  url: new URL('/blog', Astro.site).toString(),
  blogPost: posts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.title,
    url: new URL(`/blog/${post.slug}`, Astro.site).toString(),
  })),
}
---

<BaseLayout
  title="From Stage | Stage Espresso & Brewbar"
  description={description}
  contact={content.contactFormText}
  structuredData={structuredData}
>
  <main class="blog-page">
    <BlogIndexView posts={posts} />
  </main>
</BaseLayout>
