---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { EventsView } from '../../components/PageViews'
import { getProductionContent } from '../../lib/contentful'

const content = await getProductionContent()
const description =
  'Open mic nights, live music, games and community events at Stage Espresso & Brewbar in Leeds.'
const schemas = [...content.events, ...content.pastEvents].map((event) => ({
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.name,
  startDate: event.startTime,
  endDate: event.endTime,
  image: event.image?.url,
  location: {
    '@type': 'Place',
    name: 'Stage Espresso & Brewbar',
    address: '41 Great George Street, Leeds, LS1 3BB',
  },
}))
---

<BaseLayout
  title="Events at Stage | Stage Espresso & Brewbar"
  description={description}
  contact={content.contactFormText}
  structuredData={schemas}
>
  <main class="events-page">
    <header class="events-page-header section-shell">
      <h1>Events at Stage</h1>
      <p>Good coffee, good company and plenty happening after hours.</p>
    </header>
    <section class="events-page-content section-shell">
      <EventsView events={content.events} pastEvents={content.pastEvents} />
    </section>
  </main>
</BaseLayout>
