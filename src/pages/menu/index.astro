---
import BaseLayout from '../../layouts/BaseLayout.astro'
import MenuTabsView from '../../components/MenuTabsView'
import { getProductionContent } from '../../lib/contentful'

const content = await getProductionContent()
const description =
  'Explore the food and coffee menus at Stage Espresso & Brewbar, including breakfast, lunch, house-baked goods and our current coffees.'
---

<BaseLayout
  title="Our Menu | Stage Espresso & Brewbar"
  description={description}
  contact={content.contactFormText}
>
  <main>
    <MenuTabsView
      client:load
      menu={content.foodMenu}
      coffees={content.coffees}
    />
  </main>
</BaseLayout>
