CONTENTFUL_SPACE_ID=your_space_id
CONTENTFUL_DELIVERY_TOKEN=your_delivery_access_token
CONTENTFUL_MANAGEMENT_TOKEN=your_management_token_for_one_time_setup
CONTENTFUL_ENVIRONMENT=master

# These values are intentionally included in the public preview bundle.
# Optional when CONTENTFUL_SPACE_ID is already set; included here for clarity.
PUBLIC_CONTENTFUL_SPACE_ID=your_space_id
PUBLIC_CONTENTFUL_PREVIEW_TOKEN=your_preview_access_token
PUBLIC_CONTENTFUL_ENVIRONMENT=master
PUBLIC_PREVIEW_PASSWORD_HASH=sha256_of_the_shared_preview_password

# Public ID of the private Contentful Page app; this is not a secret.
PUBLIC_CONTENTFUL_ADMIN_APP_ID=your_contentful_app_definition_id
# Optional localhost override while configuring the app for development.
# CONTENTFUL_ADMIN_APP_SRC=http://localhost:4321/admin
